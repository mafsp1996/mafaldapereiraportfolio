---
import CaseStudyPage from '../../components/CaseStudyPage.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import { caseStudies, type CaseStudy } from '../../data/case-studies';
import '../../styles/global.css';

export function getStaticPaths() {
	return caseStudies.map((study) => ({
		params: { slug: study.slug },
		props: { study },
	}));
}

interface Props {
	study: CaseStudy;
}

const { study } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta
			name="description"
			content={`${study.title}: an anonymised UX research case study by Mafalda Pereira.`}
		/>
		<meta name="author" content="Mafalda Pereira" />
		<meta name="theme-color" content="#09090b" />
		<meta property="og:type" content="article" />
		<meta property="og:title" content={`${study.title} — Mafalda Pereira`} />
		<meta property="og:description" content={study.lede} />
		<meta property="og:image" content="/images/social-preview.png" />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Mafalda Pereira — UX Researcher" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:image" content="/images/social-preview.png" />
		<title>{study.title} — Mafalda Pereira</title>
	</head>
	<body>
		<div class="site-shell">
			<SiteHeader />
			<CaseStudyPage study={study} />
		</div>
	</body>
</html>
