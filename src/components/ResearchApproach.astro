---
const stages = [
	{
		number: '01',
		label: 'Frame',
		title: 'Start with the decision',
		description:
			'Clarify the product question, align the people involved and define evaluation criteria, constraints and a practical research protocol.',
	},
	{
		number: '02',
		label: 'Study',
		title: 'Observe the real context',
		description:
			'Choose and combine methods around the people, product and environment — from interviews and observation to usability testing, surveys and workshops.',
	},
	{
		number: '03',
		label: 'Translate',
		title: 'Make evidence actionable',
		description:
			'Show what worked, what did not and which changes matter most, while keeping uncertainties and study limits visible.',
	},
];

const methods = [
	'Interviews',
	'Observation',
	'Think-aloud testing',
	'Usability testing',
	'Surveys',
	'Workshops',
	'Heuristic review',
	'Benchmarking',
	'Concept evaluation',
];

const principles = [
	'Understand context before making assumptions',
	'Use evidence to challenge opinion',
	'Turn findings into clear decisions',
];
---

<section
	id="research-approach"
	class="research-approach page-frame"
	aria-labelledby="approach-heading"
>
	<header class="approach-heading">
		<div>
			<p class="approach-kicker">Practice / 02</p>
			<h2 id="approach-heading">Research approach</h2>
		</div>
		<p class="approach-register" aria-hidden="true">Question / Evidence / Decision</p>
	</header>

	<div class="approach-intro">
		<p class="approach-statement">
			Good research should leave a team knowing what to do next — and why.
		</p>
		<p class="approach-summary">
			There is no fixed recipe. A simulator study, an early concept and a literature review need
			different plans. I choose the simplest combination of methods that can answer the question,
			then show the team what I observed, what I am less certain about and what is worth changing.
		</p>
	</div>

	<figure class="research-trace">
		<div class="research-trace__canvas" aria-hidden="true">
			<svg viewBox="0 0 900 260" preserveAspectRatio="none">
				<path d="M42 196 C142 196 132 82 254 82 S360 188 466 168 S558 58 676 72 S762 162 856 112" />
				<circle cx="42" cy="196" r="7" />
				<circle cx="254" cy="82" r="7" />
				<circle cx="466" cy="168" r="7" />
				<circle cx="676" cy="72" r="7" />
				<circle cx="856" cy="112" r="7" />
			</svg>
			<ol>
				<li>
					<span>Question</span>
					<strong>What does the team need to decide?</strong>
				</li>
				<li>
					<span>In use</span>
					<strong>Where do people hesitate, adapt or work around the product?</strong>
				</li>
				<li>
					<span>Next move</span>
					<strong>What is worth changing or testing now?</strong>
				</li>
			</ol>
		</div>
		<figcaption>
			<span>A research trail</span>
			<p>
				The line is rarely this tidy. A study often loops back when the prototype changes or
				an observation shows that the original question was not quite the right one.
			</p>
		</figcaption>
	</figure>

	<ol class="approach-stages">
		{
			stages.map((stage) => (
				<li>
					<div class="stage-register">
						<span>{stage.number}</span>
						<span>{stage.label}</span>
					</div>
					<h3>{stage.title}</h3>
					<p>{stage.description}</p>
				</li>
			))
		}
	</ol>

	<div class="approach-reference method-repertoire">
		<p>Methods I use</p>
		<ul aria-label="Research methods">
			{methods.map((method) => <li>{method}</li>)}
		</ul>
	</div>

	<div
		class="approach-reference working-principles"
		role="group"
		aria-labelledby="principles-heading"
	>
		<p id="principles-heading">Working principles</p>
		<ul>
			{
				principles.map((principle, index) => (
					<li>
						<span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
						<strong>{principle}</strong>
					</li>
				))
			}
		</ul>
	</div>
</section>

<style>
	.research-approach {
		position: relative;
		padding-block: clamp(6rem, 10vw, 10rem) clamp(5rem, 8vw, 8rem);
		border-top: 1px solid var(--line);
		scroll-margin-top: calc(var(--header-height) + 1rem);
	}

	.approach-heading {
		display: grid;
		align-items: end;
		padding-bottom: clamp(2.5rem, 5vw, 4.5rem);
		grid-template-columns: 1fr auto;
		gap: 2rem;
	}

	.approach-kicker,
	.approach-register,
	.stage-register,
	.approach-reference > p {
		margin: 0;
		color: var(--muted);
		font-family: var(--mono);
		font-size: 0.64rem;
		letter-spacing: 0.11em;
		line-height: 1.5;
		text-transform: uppercase;
	}

	.approach-kicker {
		margin-bottom: 1.35rem;
		color: var(--accent);
	}

	.approach-register {
		padding-bottom: 0.9rem;
		color: rgba(242, 239, 232, 0.6);
		text-align: right;
	}

	h2,
	h3 {
		margin: 0;
		font-family: var(--display);
		font-weight: 400;
		letter-spacing: -0.045em;
	}

	h2 {
		max-width: 10ch;
		font-size: clamp(3.5rem, 6.8vw, 7.5rem);
		line-height: 0.96;
	}

	.approach-intro {
		display: grid;
		padding-block: clamp(3.5rem, 6vw, 6.5rem);
		border-top: 1px solid var(--line);
		grid-template-columns: repeat(12, minmax(0, 1fr));
		gap: clamp(2rem, 4vw, 4.5rem);
	}

	.approach-statement {
		max-width: 14ch;
		margin: 0;
		font-family: var(--display);
		font-size: clamp(2.7rem, 4.2vw, 4.9rem);
		font-weight: 400;
		letter-spacing: -0.04em;
		line-height: 1;
		text-wrap: balance;
		grid-column: 1 / 7;
	}

	.approach-summary {
		max-width: 39rem;
		margin: 0;
		align-self: end;
		color: #d5d1ca;
		font-size: clamp(1rem, 1.2vw, 1.2rem);
		letter-spacing: -0.012em;
		line-height: 1.65;
		grid-column: 8 / -1;
	}

	.research-trace {
		display: grid;
		margin: 0 0 clamp(4rem, 7vw, 7rem);
		padding-block: clamp(2rem, 3.5vw, 3.5rem);
		border-block: 1px solid var(--line);
		grid-template-columns: minmax(0, 3fr) minmax(15rem, 0.8fr);
		gap: clamp(2rem, 4vw, 4.5rem);
	}

	.research-trace__canvas {
		position: relative;
		min-height: 22rem;
		overflow: hidden;
		border: 1px solid var(--line);
		background-color: rgba(242, 239, 232, 0.018);
		background-image:
			linear-gradient(var(--line-soft) 1px, transparent 1px),
			linear-gradient(90deg, var(--line-soft) 1px, transparent 1px);
		background-size: 4rem 4rem;
	}

	.research-trace svg {
		position: absolute;
		z-index: 0;
		inset: 1rem;
		width: calc(100% - 2rem);
		height: calc(100% - 2rem);
		overflow: visible;
	}

	.research-trace path {
		fill: none;
		stroke: rgba(131, 128, 255, 0.72);
		stroke-width: 2;
		vector-effect: non-scaling-stroke;
	}

	.research-trace circle {
		fill: var(--accent);
		stroke: var(--ink);
		stroke-width: 6;
		vector-effect: non-scaling-stroke;
	}

	.research-trace ol {
		position: absolute;
		z-index: 1;
		inset: 1.5rem;
		display: grid;
		margin: 0;
		padding: 0;
		align-items: start;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1.25rem;
		list-style: none;
	}

	.research-trace li {
		width: min(100%, 15rem);
		padding: 1rem;
		border: 1px solid var(--line);
		background: rgba(9, 9, 11, 0.88);
	}

	.research-trace li:nth-child(2) {
		margin-top: 8.5rem;
		justify-self: center;
	}

	.research-trace li:nth-child(3) {
		margin-top: 2.5rem;
		justify-self: end;
	}

	.research-trace li span,
	.research-trace figcaption > span {
		color: var(--accent);
		font-family: var(--mono);
		font-size: 0.62rem;
		letter-spacing: 0.1em;
		line-height: 1.5;
		text-transform: uppercase;
	}

	.research-trace li strong {
		display: block;
		margin-top: 0.75rem;
		color: #d5d1ca;
		font-size: 0.88rem;
		font-weight: 500;
		line-height: 1.5;
	}

	.research-trace figcaption {
		align-self: end;
		padding-top: 1rem;
		border-top: 1px solid var(--line);
	}

	.research-trace figcaption p {
		margin: 1.25rem 0 0;
		color: var(--muted);
		font-size: 0.92rem;
		line-height: 1.65;
	}

	.approach-stages {
		display: grid;
		margin: 0;
		padding: 0;
		border-block: 1px solid var(--line);
		grid-template-columns: repeat(3, minmax(0, 1fr));
		list-style: none;
	}

	.approach-stages > li {
		display: flex;
		min-width: 0;
		min-height: clamp(26rem, 31vw, 34rem);
		padding: clamp(2rem, 3.5vw, 3.5rem);
		flex-direction: column;
		border-right: 1px solid var(--line);
	}

	.approach-stages > li:first-child {
		padding-left: 0;
	}

	.approach-stages > li:last-child {
		padding-right: 0;
		border-right: 0;
	}

	.stage-register {
		display: flex;
		align-items: center;
		justify-content: space-between;
		color: rgba(242, 239, 232, 0.6);
	}

	.stage-register span:first-child {
		color: var(--accent);
	}

	.approach-stages h3 {
		max-width: 8ch;
		min-height: 2.94em;
		margin-top: clamp(4rem, 6vw, 6rem);
		font-size: clamp(2.5rem, 3.6vw, 4.25rem);
		line-height: 0.98;
		text-wrap: balance;
	}

	.approach-stages li > p {
		max-width: 31rem;
		margin: 1.5rem 0 0;
		color: var(--muted);
		font-size: 0.94rem;
		line-height: 1.65;
	}

	.approach-reference {
		display: grid;
		align-items: start;
		padding-block: clamp(2.5rem, 4vw, 4rem);
		grid-template-columns: minmax(11rem, 0.75fr) 2fr;
		gap: 2rem;
	}

	.approach-reference > p {
		padding-top: 0.7rem;
		color: var(--accent);
	}

	.approach-reference ul {
		display: grid;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.method-repertoire ul {
		grid-template-columns: repeat(3, minmax(0, 1fr));
		column-gap: clamp(1.25rem, 2.5vw, 2.5rem);
	}

	.method-repertoire li {
		position: relative;
		padding: 0.8rem 0 0.8rem 1rem;
		border-top: 1px solid var(--line);
		color: var(--muted);
		font-family: var(--mono);
		font-size: 0.72rem;
		letter-spacing: 0.045em;
		line-height: 1.35;
	}

	.method-repertoire li::before {
		position: absolute;
		top: 0.8rem;
		left: 0;
		color: var(--accent);
		content: '•';
	}

	.working-principles {
		border-top: 1px solid var(--line);
	}

	.working-principles ul {
		grid-template-columns: repeat(3, 1fr);
		gap: clamp(1.5rem, 3vw, 3rem);
	}

	.working-principles li {
		display: grid;
		padding-top: 0.8rem;
		border-top: 1px solid var(--line);
		grid-template-columns: 2rem 1fr;
		gap: 0.75rem;
	}

	.working-principles li > span {
		color: var(--accent);
		font-family: var(--mono);
		font-size: 0.62rem;
		letter-spacing: 0.08em;
	}

	.working-principles strong {
		color: #d5d1ca;
		font-size: 0.92rem;
		font-weight: 400;
		line-height: 1.5;
	}

	@media (min-width: 48rem) and (max-width: 68.625rem) {
		.research-approach {
			scroll-margin-top: calc(var(--header-height) + 1rem);
		}

		.approach-intro {
			grid-template-columns: repeat(8, minmax(0, 1fr));
			gap: 2.5rem;
		}

		.approach-statement {
			font-size: clamp(3.5rem, 5vw, 3.75rem);
			grid-column: 1 / 5;
		}

		h2 {
			font-size: clamp(4.5rem, 7vw, 5.25rem);
		}

		.approach-summary {
			grid-column: 5 / -1;
		}

		.research-trace {
			grid-template-columns: minmax(0, 2.2fr) minmax(13rem, 0.8fr);
		}

		.research-trace__canvas {
			min-height: 20rem;
		}

		.approach-stages > li {
			min-height: 25rem;
			padding-inline: 1.5rem;
		}

		.approach-stages > li:first-child {
			padding-left: 0;
		}

		.approach-stages > li:last-child {
			padding-right: 0;
		}

		.approach-stages h3 {
			margin-top: 4rem;
			font-size: clamp(2.75rem, 4vw, 3rem);
		}

		.approach-reference {
			grid-template-columns: 1fr;
			gap: 1.5rem;
		}

		.approach-reference > p {
			padding-top: 0;
		}
	}

	@media (max-width: 47.999rem) {
		.research-approach {
			padding-block: 4.5rem 4rem;
			scroll-margin-top: calc(var(--header-height) + 1rem);
		}

		.approach-heading {
			grid-template-columns: 1fr;
			gap: 1rem;
		}

		.approach-register {
			display: none;
		}

		h2 {
			max-width: 8ch;
			font-size: clamp(3.35rem, 12vw, 4.5rem);
		}

		.approach-intro {
			grid-template-columns: 1fr;
			gap: 2.5rem;
		}

		.approach-statement,
		.approach-summary {
			grid-column: 1;
		}

		.approach-statement {
			font-size: clamp(2.7rem, 10vw, 3.5rem);
		}

		.research-trace {
			margin-bottom: 4rem;
			grid-template-columns: 1fr;
			gap: 1.5rem;
		}

		.research-trace__canvas {
			min-height: 31rem;
		}

		.research-trace svg {
			display: none;
		}

		.research-trace ol {
			position: relative;
			inset: auto;
			display: flex;
			padding: 1.25rem;
			flex-direction: column;
			justify-content: space-between;
			gap: 2.5rem;
		}

		.research-trace ol::before {
			position: absolute;
			top: 2rem;
			bottom: 2rem;
			left: 2rem;
			width: 1px;
			background: rgba(131, 128, 255, 0.58);
			content: '';
		}

		.research-trace li,
		.research-trace li:nth-child(2),
		.research-trace li:nth-child(3) {
			position: relative;
			width: calc(100% - 2rem);
			margin: 0 0 0 2rem;
			justify-self: auto;
		}

		.research-trace li::before {
			position: absolute;
			top: 1.35rem;
			left: -2.25rem;
			width: 0.55rem;
			height: 0.55rem;
			border: 0.22rem solid var(--ink);
			border-radius: 50%;
			background: var(--accent);
			box-sizing: content-box;
			content: '';
		}

		.approach-stages {
			grid-template-columns: 1fr;
		}

		.approach-stages > li,
		.approach-stages > li:first-child,
		.approach-stages > li:last-child {
			min-height: 23rem;
			padding: 2rem 0;
			border-right: 0;
			border-bottom: 1px solid var(--line);
		}

		.approach-stages > li:last-child {
			border-bottom: 0;
		}

		.approach-stages h3 {
			min-height: 0;
			margin-top: 3rem;
			font-size: clamp(2.65rem, 9vw, 2.75rem);
		}

		.approach-reference {
			grid-template-columns: 1fr;
			gap: 1.5rem;
		}

		.approach-reference > p {
			padding-top: 0;
		}

		.method-repertoire ul,
		.working-principles ul {
			grid-template-columns: 1fr;
		}

		.working-principles {
			padding-top: 2.5rem;
		}
	}
</style>
