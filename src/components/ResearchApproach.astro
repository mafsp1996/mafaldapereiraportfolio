---
const stages = [
	{
		number: '01',
		label: 'Frame',
		title: 'Start with the decision',
		description:
			'Clarify the product question, align the people involved and define evaluation criteria, constraints and a practical research protocol.',
	},
	{
		number: '02',
		label: 'Study',
		title: 'Observe the real context',
		description:
			'Choose and combine methods around the people, product and environment - from interviews and observation to usability testing, surveys and workshops.',
	},
	{
		number: '03',
		label: 'Translate',
		title: 'Make evidence actionable',
		description:
			'Synthesise qualitative and quantitative evidence into usability findings, design criteria and prioritised recommendations for the team.',
	},
];

const methods = [
	'Interviews',
	'Observation',
	'Think-aloud testing',
	'Usability testing',
	'Surveys',
	'Workshops',
	'Heuristic review',
	'Benchmarking',
	'Concept evaluation',
];
---

<section
	id="research-approach"
	class="research-approach page-frame"
	aria-labelledby="approach-heading"
>
	<header class="approach-heading">
		<div>
			<p class="approach-kicker">Practice / 02</p>
			<h2 id="approach-heading">Research approach</h2>
		</div>
		<p class="approach-register" aria-hidden="true">Question / Evidence / Decision</p>
	</header>

	<div class="approach-intro">
		<p class="approach-statement">
			Research becomes valuable when evidence changes what a team does next.
		</p>
		<p class="approach-summary">
			I work across the full research cycle - from framing questions and preparing protocols
			to running sessions, analysing evidence and presenting prioritised recommendations. The
			process adapts to each project's context while keeping the path from question to decision
			clear.
		</p>
	</div>

	<ol class="approach-stages">
		{
			stages.map((stage) => (
				<li>
					<div class="stage-register">
						<span>{stage.number}</span>
						<span>{stage.label}</span>
					</div>
					<h3>{stage.title}</h3>
					<p>{stage.description}</p>
				</li>
			))
		}
	</ol>

	<div class="method-repertoire">
		<p>Method repertoire</p>
		<ul aria-label="Research methods">
			{methods.map((method) => <li>{method}</li>)}
		</ul>
	</div>

	<footer class="approach-footer" aria-hidden="true">
		<span>Context over assumptions</span>
		<span>Evidence over opinion</span>
		<span>Decisions over deliverables</span>
	</footer>
</section>

<style>
	.research-approach {
		position: relative;
		padding-block: clamp(6rem, 10vw, 10rem) clamp(5rem, 8vw, 8rem);
		border-top: 1px solid var(--line);
		scroll-margin-top: var(--header-height);
	}

	.approach-heading {
		display: grid;
		align-items: end;
		padding-bottom: clamp(2.5rem, 5vw, 4.5rem);
		grid-template-columns: 1fr auto;
		gap: 2rem;
	}

	.approach-kicker,
	.approach-register,
	.stage-register,
	.method-repertoire > p,
	.approach-footer {
		margin: 0;
		color: var(--muted);
		font-family: var(--mono);
		font-size: 0.64rem;
		letter-spacing: 0.11em;
		line-height: 1.5;
		text-transform: uppercase;
	}

	.approach-kicker {
		margin-bottom: 1.35rem;
		color: var(--accent);
	}

	.approach-register {
		padding-bottom: 0.9rem;
		color: rgba(242, 239, 232, 0.36);
		text-align: right;
	}

	h2,
	h3 {
		margin: 0;
		font-family: var(--display);
		font-weight: 400;
		letter-spacing: -0.045em;
	}

	h2 {
		max-width: 10ch;
		font-size: clamp(3.5rem, 6.8vw, 7.5rem);
		line-height: 0.92;
	}

	.approach-intro {
		display: grid;
		padding-block: clamp(3.5rem, 6vw, 6.5rem);
		border-top: 1px solid var(--line);
		grid-template-columns: repeat(12, minmax(0, 1fr));
		gap: clamp(2rem, 4vw, 4.5rem);
	}

	.approach-statement {
		max-width: 14ch;
		margin: 0;
		font-family: var(--display);
		font-size: clamp(2.7rem, 4.2vw, 4.9rem);
		font-weight: 400;
		letter-spacing: -0.04em;
		line-height: 1;
		text-wrap: balance;
		grid-column: 1 / 7;
	}

	.approach-summary {
		max-width: 39rem;
		margin: 0;
		align-self: end;
		color: #d5d1ca;
		font-size: clamp(1rem, 1.2vw, 1.2rem);
		letter-spacing: -0.012em;
		line-height: 1.65;
		grid-column: 8 / -1;
	}

	.approach-stages {
		display: grid;
		margin: 0;
		padding: 0;
		border-block: 1px solid var(--line);
		grid-template-columns: repeat(3, minmax(0, 1fr));
		list-style: none;
	}

	.approach-stages > li {
		display: flex;
		min-width: 0;
		min-height: clamp(26rem, 31vw, 34rem);
		padding: clamp(2rem, 3.5vw, 3.5rem);
		flex-direction: column;
		border-right: 1px solid var(--line);
	}

	.approach-stages > li:first-child {
		padding-left: 0;
	}

	.approach-stages > li:last-child {
		padding-right: 0;
		border-right: 0;
	}

	.stage-register {
		display: flex;
		align-items: center;
		justify-content: space-between;
		color: rgba(242, 239, 232, 0.4);
	}

	.stage-register span:first-child {
		color: var(--accent);
	}

	.approach-stages h3 {
		max-width: 8ch;
		margin-top: auto;
		font-size: clamp(2.5rem, 3.6vw, 4.25rem);
		line-height: 0.98;
		text-wrap: balance;
	}

	.approach-stages li > p {
		max-width: 31rem;
		margin: 1.5rem 0 0;
		color: var(--muted);
		font-size: 0.94rem;
		line-height: 1.65;
	}

	.method-repertoire {
		display: grid;
		align-items: start;
		padding-block: clamp(2.5rem, 4vw, 4rem);
		grid-template-columns: minmax(11rem, 0.75fr) 2fr;
		gap: 2rem;
	}

	.method-repertoire > p {
		padding-top: 0.7rem;
		color: var(--accent);
	}

	.method-repertoire ul {
		display: flex;
		margin: 0;
		padding: 0;
		flex-wrap: wrap;
		gap: 0.5rem;
		list-style: none;
	}

	.method-repertoire li {
		padding: 0.65rem 0.8rem;
		border: 1px solid var(--line);
		background: rgba(242, 239, 232, 0.018);
		color: var(--muted);
		font-family: var(--mono);
		font-size: 0.65rem;
		letter-spacing: 0.045em;
		line-height: 1;
	}

	.approach-footer {
		display: grid;
		padding-top: 1.5rem;
		border-top: 1px solid var(--line);
		grid-template-columns: repeat(3, 1fr);
		gap: 1.5rem;
		color: rgba(242, 239, 232, 0.34);
	}

	.approach-footer span:nth-child(2) {
		text-align: center;
	}

	.approach-footer span:last-child {
		text-align: right;
	}

	@media (min-width: 48rem) and (max-width: 68.625rem) {
		.research-approach {
			scroll-margin-top: 8.25rem;
		}

		.approach-intro {
			grid-template-columns: repeat(8, minmax(0, 1fr));
			gap: 2.5rem;
		}

		.approach-statement {
			font-size: clamp(2.6rem, 5vw, 3.6rem);
			grid-column: 1 / 5;
		}

		.approach-summary {
			grid-column: 5 / -1;
		}

		.approach-stages > li {
			min-height: 25rem;
			padding-inline: 1.5rem;
		}

		.approach-stages > li:first-child {
			padding-left: 0;
		}

		.approach-stages > li:last-child {
			padding-right: 0;
		}

		.approach-stages h3 {
			font-size: clamp(2.2rem, 4.2vw, 3rem);
		}
	}

	@media (max-width: 47.999rem) {
		.research-approach {
			padding-block: 4.5rem 4rem;
			scroll-margin-top: 8.25rem;
		}

		.approach-heading {
			grid-template-columns: 1fr;
			gap: 1rem;
		}

		.approach-register {
			display: none;
		}

		h2 {
			max-width: 8ch;
			font-size: clamp(3.35rem, 16vw, 5rem);
		}

		.approach-intro {
			grid-template-columns: 1fr;
			gap: 2.5rem;
		}

		.approach-statement,
		.approach-summary {
			grid-column: 1;
		}

		.approach-statement {
			font-size: clamp(2.7rem, 12vw, 3.8rem);
		}

		.approach-stages {
			grid-template-columns: 1fr;
		}

		.approach-stages > li,
		.approach-stages > li:first-child,
		.approach-stages > li:last-child {
			min-height: 23rem;
			padding: 2rem 0;
			border-right: 0;
			border-bottom: 1px solid var(--line);
		}

		.approach-stages > li:last-child {
			border-bottom: 0;
		}

		.approach-stages h3 {
			font-size: clamp(2.65rem, 12vw, 3.8rem);
		}

		.method-repertoire {
			grid-template-columns: 1fr;
			gap: 1.5rem;
		}

		.method-repertoire > p {
			padding-top: 0;
		}

		.approach-footer {
			display: flex;
			flex-direction: column;
			gap: 0.65rem;
		}

		.approach-footer span:nth-child(2),
		.approach-footer span:last-child {
			text-align: left;
		}
	}
</style>
