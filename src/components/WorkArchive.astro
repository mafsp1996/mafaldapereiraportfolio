---
import { projects } from '../data/projects';

const caseStudyCount = projects.filter((project) => project.caseStudySlug).length;
const baseUrl = import.meta.env.BASE_URL;
---

<section class="work-archive page-frame" aria-labelledby="archive-heading">
	<header class="archive-header">
		<div class="archive-register">
			<span>Project archive</span>
			<span aria-hidden="true">01—06 / Research dossier</span>
		</div>
		<h1 id="archive-heading">Work archive</h1>
		<div class="archive-rule">
			<span>{String(caseStudyCount).padStart(2, '0')} case studies / 06 selected engagements</span>
			<span>[Research / Decisions]</span>
		</div>
	</header>

	<div class="archive-list">
		{
			projects.map((project) => (
				<article class:list={['archive-card', `archive-card--${project.archiveLayout}`]}>
					<div class="archive-card__info">
						<span class="archive-card__number">{project.number}</span>
						<div class="archive-card__copy">
							<h2>{project.title}</h2>
							<p class="archive-card__contribution">{project.contribution}</p>
							<p class="archive-card__description">{project.description}</p>
							{
								project.caseStudySlug ? (
									<a
										class="archive-card__link"
										href={`${baseUrl}work/${project.caseStudySlug}`}
										aria-label={`Read case study: ${project.title}`}
									>
										Read case study <span aria-hidden="true">→</span>
									</a>
								) : project.number === '06' ? (
									<a
										class="archive-card__link"
										href="mailto:mafaldapereirafmh@gmail.com?subject=Private%20case%20walkthrough"
									>
										Request private walkthrough <span aria-hidden="true">↗</span>
									</a>
								) : (
									<span class="archive-card__summary-label">Project summary</span>
								)
							}
						</div>
					</div>

					<figure class="archive-card__media">
						<img
										src={`${baseUrl}${project.image.replace(/^\//, '')}`}
							alt={project.imageAlt}
							width="1200"
							height="800"
							loading={project.number === '01' ? 'eager' : 'lazy'}
							decoding="async"
						/>
						<span class="media-label" aria-hidden="true">{project.mediaLabel ?? 'Research visual'}</span>
						<span class="media-code" aria-hidden="true">FIG / {project.number}</span>
					</figure>
				</article>
			))
		}
	</div>

	<footer class="archive-footer">
		<div>
			<span>Confidentiality</span>
			<p>Client names and identifying details are removed or generalised throughout.</p>
		</div>
		<a href="mailto:mafaldapereirafmh@gmail.com?subject=Portfolio%20conversation">
			Start a conversation <span aria-hidden="true">↗</span>
		</a>
	</footer>
</section>

<style>
	.work-archive {
		padding-block: clamp(4rem, 7vw, 7rem) clamp(5rem, 8vw, 8rem);
	}

	.archive-header {
		padding-bottom: clamp(4rem, 7vw, 7rem);
	}

	.archive-register,
	.archive-rule,
	.archive-footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
		color: var(--muted);
		font-family: var(--mono);
		font-size: 0.63rem;
		letter-spacing: 0.11em;
		line-height: 1.5;
		text-transform: uppercase;
	}

	.archive-register span:first-child {
		color: var(--accent);
	}

	h1,
	h2 {
		margin: 0;
		font-family: var(--display);
		font-weight: 400;
		letter-spacing: -0.05em;
	}

	h1 {
		max-width: 10ch;
		margin-block: clamp(3.5rem, 8vw, 8rem);
		font-size: clamp(5rem, 10.5vw, 12rem);
		line-height: 0.96;
	}

	.archive-rule {
		padding-top: 1rem;
		border-top: 1px solid var(--line);
		color: rgba(242, 239, 232, 0.6);
	}

	.archive-list {
		border-bottom: 1px solid var(--line);
	}

	.archive-card {
		display: grid;
		padding-block: clamp(4rem, 7vw, 7.5rem);
		border-top: 1px solid var(--line);
		grid-template-columns: repeat(12, minmax(0, 1fr));
		gap: clamp(1.5rem, 3vw, 3.5rem);
	}

	.archive-card__info {
		display: flex;
		min-width: 0;
		flex-direction: column;
		justify-content: flex-start;
		gap: clamp(1.5rem, 2vw, 2.25rem);
	}

	.archive-card__number {
		color: var(--accent);
		font-family: var(--mono);
		font-size: 0.68rem;
		letter-spacing: 0.11em;
	}

	.archive-card h2 {
		max-width: 11ch;
		font-size: clamp(3rem, 4.6vw, 5.5rem);
		line-height: 0.96;
		text-wrap: balance;
	}

	.archive-card__contribution {
		margin: 1.35rem 0 0;
		color: var(--muted);
		font-family: var(--mono);
		font-size: 0.65rem;
		letter-spacing: 0.075em;
		line-height: 1.5;
		text-transform: uppercase;
	}

	.archive-card__description {
		max-width: 34rem;
		margin: 1.5rem 0 0;
		color: rgba(242, 239, 232, 0.68);
		font-family: var(--sans);
		font-size: clamp(0.92rem, 1.05vw, 1.05rem);
		line-height: 1.65;
		text-wrap: pretty;
	}

	.archive-card__link {
		display: inline-flex;
		min-height: 2.75rem;
		margin-top: 1.25rem;
		align-items: center;
		gap: 0.65rem;
		color: var(--paper);
		font-size: 0.73rem;
		font-weight: 650;
		letter-spacing: 0.075em;
		text-decoration: none;
		text-transform: uppercase;
	}

	.archive-card__link span {
		color: var(--accent);
		transition: transform 180ms ease;
	}

	.archive-card__link:hover span,
	.archive-card__link:focus-visible span {
		transform: translateX(0.25rem);
	}

	.archive-card__summary-label {
		display: block;
		margin-top: 1.8rem;
		color: rgba(242, 239, 232, 0.58);
		font-family: var(--mono);
		font-size: 0.66rem;
		letter-spacing: 0.09em;
		text-transform: uppercase;
	}

	.archive-card__media {
		position: relative;
		min-height: 25rem;
		margin: 0;
		overflow: hidden;
		border: 1px solid var(--line);
		background-color: rgba(242, 239, 232, 0.018);
		background-image:
			linear-gradient(var(--line-soft) 1px, transparent 1px),
			linear-gradient(90deg, var(--line-soft) 1px, transparent 1px),
			linear-gradient(135deg, transparent calc(50% - 0.5px), var(--line) 50%, transparent calc(50% + 0.5px));
		background-size: 4rem 4rem, 4rem 4rem, 100% 100%;
	}

	.archive-card__media img {
		position: absolute;
		inset: 0;
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.archive-card__media::before,
	.archive-card__media::after {
		position: absolute;
		content: '';
		pointer-events: none;
	}

	.archive-card__media::before {
		top: 50%;
		left: 50%;
		z-index: 1;
		width: 5rem;
		height: 5rem;
		border: 1px solid rgba(131, 128, 255, 0.42);
		border-radius: 50%;
		transform: translate(-50%, -50%);
	}

	.archive-card__media::after {
		inset: 1rem;
		z-index: 1;
		border: 1px solid rgba(242, 239, 232, 0.055);
	}

	.media-label,
	.media-code {
		position: absolute;
		z-index: 2;
		color: rgba(242, 239, 232, 0.42);
		font-family: var(--mono);
		font-size: 0.58rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.media-label {
		top: 1.65rem;
		left: 1.65rem;
		padding: 0.42rem 0.55rem;
		background: rgba(23, 23, 25, 0.72);
	}

	.media-code {
		right: 1.65rem;
		bottom: 1.65rem;
		color: var(--accent);
	}

	.archive-card--lead .archive-card__media {
		min-height: clamp(31rem, 40vw, 44rem);
		grid-column: 1 / 8;
		grid-row: 1;
	}

	.archive-card--lead .archive-card__info {
		grid-column: 9 / -1;
		grid-row: 1;
	}

	.archive-card--lead h2 {
		font-size: clamp(3.7rem, 5.7vw, 6.8rem);
	}

	.archive-card--right .archive-card__info {
		grid-column: 1 / 6;
	}

	.archive-card--right .archive-card__media {
		min-height: clamp(27rem, 35vw, 38rem);
		grid-column: 7 / -1;
	}

	.archive-card--right .archive-card__media::before {
		width: 8rem;
		border-radius: 0;
		transform: translate(-50%, -50%) rotate(45deg);
	}

	.archive-card--left .archive-card__media {
		min-height: clamp(25rem, 32vw, 34rem);
		grid-column: 1 / 6;
		grid-row: 1;
	}

	.archive-card--left .archive-card__info {
		grid-column: 7 / -1;
		grid-row: 1;
	}

	.archive-card--left .archive-card__media::before {
		width: 10rem;
		height: 1px;
		border: 0;
		border-top: 1px solid rgba(131, 128, 255, 0.55);
		border-radius: 0;
	}

	.archive-card--narrow .archive-card__info {
		grid-column: 2 / 6;
	}

	.archive-card--narrow .archive-card__media {
		min-height: clamp(29rem, 37vw, 40rem);
		grid-column: 7 / 12;
	}

	.archive-card--narrow .archive-card__media::before {
		width: 3.5rem;
		height: 11rem;
		border-radius: 0;
	}

	.archive-card--closing .archive-card__media {
		min-height: clamp(23rem, 29vw, 31rem);
		margin-top: clamp(2rem, 5vw, 5rem);
		grid-column: 3 / 9;
		grid-row: 1;
	}

	.archive-card--closing .archive-card__info {
		grid-column: 9 / -1;
		grid-row: 1;
	}

	.archive-card--closing .archive-card__media::before {
		width: 7rem;
		height: 7rem;
		box-shadow: 0 0 0 1.75rem rgba(131, 128, 255, 0.035);
	}

	.archive-card--confidential .archive-card__info {
		grid-column: 1 / 6;
	}

	.archive-card--confidential .archive-card__media {
		min-height: clamp(24rem, 31vw, 34rem);
		grid-column: 7 / -1;
	}

	.archive-card--confidential .archive-card__media::before {
		width: 11rem;
		height: 6rem;
		border-color: rgba(131, 128, 255, 0.32);
		border-radius: 0;
	}

	.archive-card--confidential .media-label {
		color: var(--accent);
	}

	.archive-footer {
		padding-top: 2rem;
		color: rgba(242, 239, 232, 0.5);
	}

	.archive-footer > div {
		display: flex;
		max-width: 38rem;
		flex-direction: column;
		gap: 0.6rem;
	}

	.archive-footer p {
		margin: 0;
		color: var(--muted);
		font-family: var(--sans);
		font-size: 0.86rem;
		letter-spacing: 0;
		line-height: 1.55;
		text-transform: none;
	}

	.archive-footer a {
		display: inline-flex;
		min-height: 2.75rem;
		align-items: center;
		gap: 0.6rem;
		color: var(--paper);
		text-decoration: none;
	}

	.archive-footer a span {
		color: var(--accent);
	}

	@media (min-width: 48rem) and (max-width: 68.625rem) {
		.work-archive {
			padding-block: 4.5rem 5rem;
		}

		h1 {
			font-size: clamp(6rem, 10.5vw, 7.5rem);
		}

		.archive-card {
			grid-template-columns: repeat(8, minmax(0, 1fr));
			gap: 1.75rem;
		}

		.archive-card h2,
		.archive-card--lead h2 {
			font-size: clamp(3rem, 4.6vw, 3.25rem);
		}

		.archive-card--lead .archive-card__media,
		.archive-card--left .archive-card__media {
			min-height: 27rem;
			grid-column: 1 / 5;
		}

		.archive-card--lead .archive-card__info,
		.archive-card--left .archive-card__info {
			grid-column: 5 / -1;
		}

		.archive-card--right .archive-card__info,
		.archive-card--narrow .archive-card__info,
		.archive-card--confidential .archive-card__info {
			grid-column: 1 / 5;
		}

		.archive-card--right .archive-card__media,
		.archive-card--narrow .archive-card__media,
		.archive-card--confidential .archive-card__media {
			min-height: 25rem;
			grid-column: 5 / -1;
		}

		.archive-card--closing .archive-card__media {
			min-height: 22rem;
			margin-top: 2.5rem;
			grid-column: 1 / 6;
		}

		.archive-card--closing .archive-card__info {
			grid-column: 6 / -1;
		}
	}

	@media (max-width: 47.999rem) {
		.work-archive {
			padding-block: 3rem 4rem;
		}

		.archive-header {
			padding-bottom: 4rem;
		}

		.archive-register span:last-child {
			display: none;
		}

		.archive-rule {
			align-items: flex-start;
			gap: 1rem;
		}

		.archive-rule span:last-child {
			display: none;
		}

		h1 {
			margin-block: 3.5rem;
			font-size: clamp(4.6rem, 22vw, 6rem);
		}

		.archive-card {
			display: flex;
			padding-block: 3.5rem;
			flex-direction: column;
			gap: 2.5rem;
		}

		.archive-card__info {
			gap: 1.5rem;
		}

		.archive-card h2,
		.archive-card--lead h2 {
			max-width: 12ch;
			font-size: clamp(2.75rem, 9.5vw, 3.25rem);
		}

		.archive-card__media,
		.archive-card--lead .archive-card__media,
		.archive-card--right .archive-card__media,
		.archive-card--left .archive-card__media,
		.archive-card--narrow .archive-card__media,
		.archive-card--closing .archive-card__media,
		.archive-card--confidential .archive-card__media {
			width: 100%;
			min-height: 19rem;
			margin-top: 0;
		}

		.archive-card--lead .archive-card__media {
			min-height: 24rem;
			order: -1;
		}

		.archive-card--right .archive-card__media,
		.archive-card--narrow .archive-card__media {
			width: 86%;
			align-self: flex-end;
		}

		.archive-card--left .archive-card__media {
			width: 88%;
			align-self: flex-start;
			order: -1;
		}

		.archive-card--closing .archive-card__media {
			width: 90%;
			min-height: 16rem;
			align-self: center;
		}

		.archive-card--confidential .archive-card__media {
			width: 92%;
			min-height: 17rem;
			align-self: flex-start;
		}

		.archive-card__description {
			font-size: 0.95rem;
		}

		.archive-footer {
			align-items: flex-start;
			flex-direction: column;
			gap: 1.75rem;
		}
	}

	@media (min-width: 68.6875rem) {
		.work-archive {
			padding-top: clamp(3.25rem, 5.25vw, 5.25rem);
		}

		.archive-header {
			padding-bottom: clamp(2.75rem, 4.25vw, 4.25rem);
		}

		h1 {
			margin-block: clamp(2.75rem, 6vw, 6rem);
		}

		.archive-card {
			padding-block: clamp(3rem, 5.25vw, 5.625rem);
		}
	}
</style>
