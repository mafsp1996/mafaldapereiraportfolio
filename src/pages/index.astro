---
import About from '../components/About.astro';
import Hero from '../components/Hero.astro';
import ResearchApproach from '../components/ResearchApproach.astro';
import SeoHead from '../components/SeoHead.astro';
import SelectedWork from '../components/SelectedWork.astro';
import SiteHeader from '../components/SiteHeader.astro';
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<SeoHead />
		<meta name="author" content="Mafalda Pereira" />
		<meta name="theme-color" content="#09090b" />
		<script
			type="application/ld+json"
			set:html={JSON.stringify({
				'@context': 'https://schema.org',
				'@type': 'Person',
				name: 'Mafalda Pereira',
				jobTitle: 'UX Researcher',
				email: 'mailto:mafaldapereirafmh@gmail.com',
				sameAs: ['https://www.linkedin.com/in/mafalda-pereira-872824187/'],
				address: {
					'@type': 'PostalAddress',
					addressLocality: 'Braga',
					addressCountry: 'PT',
				},
				knowsLanguage: ['Portuguese', 'English', 'Spanish'],
			})}
		></script>
	</head>
	<body>
		<div class="site-shell">
			<SiteHeader />
			<main id="main-content" tabindex="-1">
				<Hero />
				<SelectedWork />
				<ResearchApproach />
				<About />
			</main>
		</div>
	</body>
</html>
