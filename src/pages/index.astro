import SiteHeader from '../components/SiteHeader.astro';
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta
			name="description"
			content="Mafalda Pereira is a UX Researcher turning complex human behaviour into clear product decisions."
		/>
