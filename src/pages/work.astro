---
import SiteHeader from '../components/SiteHeader.astro';
import SeoHead from '../components/SeoHead.astro';
import WorkArchive from '../components/WorkArchive.astro';
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<SeoHead
			title="Work — Mafalda Pereira"
			description="UX research work by Mafalda Pereira across product research, usability and discovery."
			canonicalPath="/work/"
		/>
		<meta name="author" content="Mafalda Pereira" />
		<meta name="theme-color" content="#09090b" />
	</head>
	<body>
		<div class="site-shell">
			<SiteHeader />
			<main id="main-content" tabindex="-1">
				<WorkArchive />
			</main>
		</div>
	</body>
</html>
