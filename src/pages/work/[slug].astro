---
import CaseStudyPage from '../../components/CaseStudyPage.astro';
import SeoHead from '../../components/SeoHead.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import { caseStudies, type CaseStudy } from '../../data/case-studies';
import '../../styles/global.css';

export function getStaticPaths() {
	return caseStudies.map((study) => ({
		params: { slug: study.slug },
		props: { study },
	}));
}

interface Props {
	study: CaseStudy;
}

const { study } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<SeoHead
			title={`${study.title} — Mafalda Pereira`}
			description={`${study.title}: an anonymised UX research case study by Mafalda Pereira.`}
			canonicalPath={`/work/${study.slug}/`}
			type="article"
		/>
		<meta name="author" content="Mafalda Pereira" />
		<meta name="theme-color" content="#09090b" />
	</head>
	<body>
		<div class="site-shell">
			<SiteHeader />
			<CaseStudyPage study={study} />
		</div>
	</body>
</html>
